# Copy to .env for local development. Nothing here is a real secret.
DEVICELAB_DATABASE_URL=postgresql+asyncpg://devicelab:devicelab@localhost:5432/devicelab
DEVICELAB_CORS_ORIGINS=["http://localhost:5173"]
DEVICELAB_ARTIFACT_DIR=./artifacts-data
# Set to create an admin API key on first start when none exist.
DEVICELAB_BOOTSTRAP_ADMIN_KEY=
# 1 seeds templates, schedules and a history of executions.
DEVICELAB_DEMO=0
